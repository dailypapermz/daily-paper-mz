generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum ZoteroSyncMode {
  FULL
  INCREMENTAL
}

enum ZoteroSyncStatus {
  RUNNING
  SUCCESS
  FAILED
}

enum CollectionPriority {
  PRIMARY
  SECONDARY
  EXCLUDED
}

enum ResearchTypeCategory {
  METHOD
  BIOLOGY
  RESOURCE
  BENCHMARK
}

enum StructuredTagParseStatus {
  PARSED
  PARTIAL
  INVALID_CATEGORY
  UNPARSED
}

enum TagProvenance {
  ORIGINAL
  GENERATED
}

enum TagGenerationJobStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

enum TagGenerationItemStatus {
  GENERATED
  SKIPPED_UNAVAILABLE
  FAILED
}

enum ProfileSnapshotStatus {
  ACTIVE
  SUPERSEDED
}

enum ProfileInterestSegment {
  RECENT_CORE
  STABLE_LONG_TERM
  BACKGROUND
}

enum ProfileRepresentationSource {
  STRUCTURED_TAGS
  TITLE_ABSTRACT
}

enum ProfileRefreshTrigger {
  INITIAL
  MANUAL
  SCHEDULED
}

enum ProfileRefreshJobStatus {
  RUNNING
  SUCCESS
  FAILED
}

model ZoteroSyncRun {
  id               String           @id @default(cuid())
  mode             ZoteroSyncMode
  status           ZoteroSyncStatus @default(RUNNING)
  startedAt        DateTime         @default(now())
  finishedAt       DateTime?
  sinceVersion     Int?
  libraryVersion   Int?
  itemsCount       Int              @default(0)
  collectionsCount Int              @default(0)
  mappingsCount    Int              @default(0)
  errorMessage     String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([status, startedAt])
}

model ZoteroItemRaw {
  id                 String                        @id @default(cuid())
  zoteroItemKey      String                        @unique
  zoteroVersion      Int?
  title              String?
  abstractNote       String?
  dateAdded          DateTime?
  rawTagsJson        Json?
  rawCollectionsJson Json?
  sourcePayloadJson  Json
  syncedAt           DateTime
  libraryVersion     Int?
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt
  itemCollections    ZoteroItemCollection[]
  tagSignal          ZoteroItemTagSignal?
  contentTags        ZoteroItemContentTag[]
  contentRecallTags  ZoteroItemContentRecallTag[]
  researchTypeTags   ZoteroItemResearchTypeTag[]
  generationJobItems ZoteroTagGenerationJobItem[]
  profileSignals     ProfileSnapshotItemSignal[]

  @@index([syncedAt])
  @@index([libraryVersion])
}

model ZoteroCollection {
  id                  String                            @id @default(cuid())
  zoteroCollectionKey String                            @unique
  zoteroVersion       Int?
  name                String
  parentCollectionKey String?
  path                String?
  sourcePayloadJson   Json
  syncedAt            DateTime
  libraryVersion      Int?
  createdAt           DateTime                          @default(now())
  updatedAt           DateTime                          @updatedAt
  itemCollections     ZoteroItemCollection[]
  prioritySelection   ZoteroCollectionPrioritySelection?
  effectivePriority   ZoteroCollectionEffectivePriority?

  @@index([parentCollectionKey])
  @@index([syncedAt])
}

model ZoteroItemCollection {
  id           String           @id @default(cuid())
  itemId       String
  collectionId String
  mappedAt     DateTime         @default(now())
  item         ZoteroItemRaw    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  collection   ZoteroCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([itemId, collectionId])
  @@index([itemId])
  @@index([collectionId])
}

model ZoteroItemTagSignal {
  id              String        @id @default(cuid())
  itemId          String        @unique
  attentionLevel  Int           @default(0)
  rawStarTagsJson Json?
  otherTagsJson   Json?
  parsedAt        DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  item            ZoteroItemRaw @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([attentionLevel])
}

model ZoteroItemContentTag {
  id        String        @id @default(cuid())
  itemId    String
  rawTag    String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  item      ZoteroItemRaw @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, rawTag])
  @@index([itemId])
  @@index([rawTag])
}

model ZoteroItemContentRecallTag {
  id          String                   @id @default(cuid())
  itemId       String
  rawTag       String
  label        String?
  provenance   TagProvenance            @default(ORIGINAL)
  generationJobId String?
  parseStatus  StructuredTagParseStatus
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  item         ZoteroItemRaw            @relation(fields: [itemId], references: [id], onDelete: Cascade)
  generationJob ZoteroTagGenerationJob? @relation(fields: [generationJobId], references: [id], onDelete: SetNull)

  @@unique([itemId, rawTag])
  @@index([itemId])
  @@index([provenance])
  @@index([generationJobId])
  @@index([parseStatus])
}

model ZoteroItemResearchTypeTag {
  id               String                   @id @default(cuid())
  itemId            String
  rawTag            String
  rawCategoryToken  String?
  category          ResearchTypeCategory?
  primaryKeyword    String?
  secondaryKeyword  String?
  provenance        TagProvenance            @default(ORIGINAL)
  generationJobId   String?
  parseStatus       StructuredTagParseStatus
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  item              ZoteroItemRaw            @relation(fields: [itemId], references: [id], onDelete: Cascade)
  generationJob     ZoteroTagGenerationJob?  @relation(fields: [generationJobId], references: [id], onDelete: SetNull)

  @@unique([itemId, rawTag])
  @@index([itemId])
  @@index([category])
  @@index([provenance])
  @@index([generationJobId])
  @@index([parseStatus])
}

model ZoteroCollectionPrioritySelection {
  id           String             @id @default(cuid())
  collectionId String             @unique
  priority     CollectionPriority
  selectedAt   DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  collection   ZoteroCollection   @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@index([priority])
}

model ZoteroCollectionEffectivePriority {
  id                 String             @id @default(cuid())
  collectionId       String             @unique
  priority           CollectionPriority
  isExplicitOverride Boolean
  computedAt         DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  collection         ZoteroCollection   @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@index([priority])
  @@index([isExplicitOverride])
}

model ZoteroTagGenerationJob {
  id                 String                     @id @default(cuid())
  status             TagGenerationJobStatus     @default(RUNNING)
  provider           String
  startedAt          DateTime                   @default(now())
  finishedAt         DateTime?
  selectedItemsCount Int                        @default(0)
  missingItemsCount  Int                        @default(0)
  generatedItemsCount Int                       @default(0)
  fallbackItemsCount Int                        @default(0)
  errorMessage       String?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  items              ZoteroTagGenerationJobItem[]
  generatedContentRecallTags ZoteroItemContentRecallTag[]
  generatedResearchTypeTags  ZoteroItemResearchTypeTag[]

  @@index([status, startedAt])
}

model ZoteroTagGenerationJobItem {
  id           String                  @id @default(cuid())
  jobId        String
  itemId       String
  status       TagGenerationItemStatus
  usedFallback Boolean                 @default(false)
  errorMessage String?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  job          ZoteroTagGenerationJob  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  item         ZoteroItemRaw           @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([jobId, itemId])
  @@index([jobId])
  @@index([itemId])
  @@index([status])
}

model ProfileSnapshot {
  id                       String                                 @id @default(cuid())
  status                   ProfileSnapshotStatus                  @default(ACTIVE)
  builtAt                  DateTime                               @default(now())
  sourceLibraryVersion     Int?
  itemsCount               Int                                    @default(0)
  summaryJson              Json?
  createdAt                DateTime                               @default(now())
  updatedAt                DateTime                               @updatedAt
  itemSignals              ProfileSnapshotItemSignal[]
  researchTypePreferences  ProfileSnapshotResearchTypePreference[]
  refreshJobs              ProfileRefreshJob[]

  @@index([status, builtAt])
}

model ProfileSnapshotItemSignal {
  id                   String                      @id @default(cuid())
  snapshotId           String
  itemId               String
  segment              ProfileInterestSegment
  finalWeight          Float
  collectionWeight     Float
  attentionWeight      Float
  recencyWeight        Float
  representationSource ProfileRepresentationSource
  contentRecallLabel   String?
  researchCategory     ResearchTypeCategory?
  representationText   String
  createdAt            DateTime                    @default(now())
  snapshot             ProfileSnapshot             @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  item                 ZoteroItemRaw               @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([snapshotId])
  @@index([itemId])
  @@index([segment])
}

model ProfileSnapshotResearchTypePreference {
  id        String               @id @default(cuid())
  snapshotId String
  category  ResearchTypeCategory
  weight    Float
  itemCount Int
  createdAt DateTime             @default(now())
  snapshot  ProfileSnapshot      @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, category])
  @@index([snapshotId])
}

model ProfileRefreshJob {
  id          String                 @id @default(cuid())
  trigger     ProfileRefreshTrigger
  status      ProfileRefreshJobStatus @default(RUNNING)
  startedAt   DateTime               @default(now())
  finishedAt  DateTime?
  snapshotId  String?
  errorMessage String?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  snapshot    ProfileSnapshot?       @relation(fields: [snapshotId], references: [id], onDelete: SetNull)

  @@index([status, startedAt])
  @@index([trigger, startedAt])
}

model ProfileReminderCheck {
  id            String   @id @default(cuid())
  checkedAt     DateTime @default(now())
  lastRefreshAt DateTime?
  isDue         Boolean
  createdAt     DateTime @default(now())

  @@index([checkedAt])
  @@index([isDue, checkedAt])
}
