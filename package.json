{
  "name": "daily-paper",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --pool=threads",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "check:env": "node scripts/check-env.mjs",
    "job:daily": "node scripts/scheduler-worker.mjs --mode=daily",
    "job:monthly-reminder": "node scripts/scheduler-worker.mjs --mode=monthly",
    "job:scheduler-loop": "node scripts/scheduler-worker.mjs --mode=loop",
    "predev": "npm run check:env",
    "prestart": "npm run check:env",
    "pretypecheck": "npm run prisma:generate",
    "prebuild": "npm run prisma:generate",
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "test:config": "node --test scripts/check-env.test.mjs scripts/doctor.test.mjs scripts/setup.test.mjs && vitest run src/lib/config/env.test.ts --pool=threads",
    "prisma:migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "dotenv": "^16.6.1",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prisma": "^6.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22 <25"
  }
}
