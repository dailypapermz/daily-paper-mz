    "pretypecheck": "npm run prisma:generate",
    "prebuild": "npm run prisma:generate"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "dotenv": "^16.6.1",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prisma": "^6.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  }
}
