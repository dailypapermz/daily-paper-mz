{
  "name": "daily-paper",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --pool=threads",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "check:env": "node scripts/check-env.mjs",
    "job:daily": "node scripts/scheduler-worker.mjs --mode=daily",
    "job:daily:cloud": "tsx scripts/run-daily-cloud.ts",
    "job:monthly-reminder": "node scripts/scheduler-worker.mjs --mode=monthly",
    "job:scheduler-loop": "node scripts/scheduler-worker.mjs --mode=loop",
    "predev": "npm run check:env",
    "prestart": "npm run check:env",
    "pretypecheck": "npm run prisma:generate:all",
    "prebuild": "npm run prisma:generate:all",
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "test:config": "node --test scripts/check-env.test.mjs scripts/doctor.test.mjs scripts/setup.test.mjs && vitest run src/lib/config/env.test.ts --pool=threads",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:local:validate": "node scripts/validate-prisma.mjs local",
    "prisma:local:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:local:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "prisma:cloud:validate": "node scripts/validate-prisma.mjs cloud",
    "prisma:cloud:generate": "prisma generate --schema prisma/postgresql/schema.prisma",
    "prisma:cloud:migrate:deploy": "prisma migrate deploy --schema prisma/postgresql/schema.prisma",
    "prisma:generate:all": "npm run prisma:local:generate && npm run prisma:cloud:generate",
    "test:db-contract": "npm run prisma:generate:all && node --test scripts/database-contract.test.mjs && vitest run src/db/prisma/runtime.test.ts src/db/prisma/client.test.ts src/db/repositories/postgresql-database.integration.test.ts src/db/repositories/daily-execution-postgresql.integration.test.ts --pool=threads",
    "pretest": "npm run prisma:generate:all"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "dotenv": "^16.6.1",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prisma": "^6.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22 <25"
  }
}
