{
  "name": "daily-paper",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --pool=threads",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "check:env": "node scripts/check-env.mjs",
